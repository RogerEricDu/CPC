{
  "name": "cpc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:cpc-dev": "npm run validate:map && vue-cli-service build --mode cpc-dev && npm run validate:bundle",
    "build:cpc-prod": "npm run validate:map && vue-cli-service build --mode cpc-prod && npm run validate:bundle",
    "validate:map": "node scripts/validate-world-map.js",
    "validate:bundle": "node scripts/validate-initial-bundle.js",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@antv/l7": "^2.9.27",
    "@antv/l7-maps": "^2.9.27",
    "@fontsource/roboto": "^5.2.9",
    "@jbrowse/cli": "^4.0.4",
    "@jbrowse/react-app": "^3.1.0",
    "@jbrowse/react-linear-genome-view2": "4.3.0",
    "aos": "^2.3.4",
    "axios": "^1.2.3",
    "bootstrap": "^5.2.1",
    "core-js": "^3.8.3",
    "echarts": "^5.6.0",
    "element-ui": "^2.15.14",
    "geobuf": "^3.0.2",
    "marked": "^0.3.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vue": "^2.6.14",
    "vue-axios": "^3.5.2",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.69.7",
    "sass-loader": "^13.0.2",
    "vue-template-compiler": "^2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
